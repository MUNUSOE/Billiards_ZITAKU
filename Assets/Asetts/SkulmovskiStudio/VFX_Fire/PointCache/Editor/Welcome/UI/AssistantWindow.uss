:root {
    --accent: #3A86FF;
    --accent-text: #FFFFFF;
    --bg: #282828;
    --bg-studio-bar: #1E1E1E;
    --bg-header: #232323;
    --bg-card: #2F2F2F;
    --bg-card-hover: #353535;
    --bg-card-reminder: #2A2A2A;
    --border: #3D3D3D;
    --border-strong: #4A4A4A;
    --text-primary: #E8E8E8;
    --text-secondary: #8A8A8A;
    --text-title: #F0F0F0;
    --text-muted: #6A6A6A;
    --status-ok: #5DCAA5;
    --status-warning: #EF9F27;
    --status-error: #E24B4A;
    --status-manual: #8A7AE0;
}

.root {
    flex-grow: 1;
    background-color: var(--bg);
    min-width: 600px;
}

.studio-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 12px 16px;
    background-color: var(--bg-studio-bar);
    border-bottom-width: 1px;
    border-bottom-color: #333333;
}

.studio-logo {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    margin-right: 10px;
    flex-shrink: 0;
}

.studio-name {
    font-size: 12px;
    color: var(--text-secondary);
}

.spacer {
    flex-grow: 1;
}

.social-links {
    flex-direction: row;
}

.theme-toggle {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--border-strong);
    overflow: hidden;
}

.theme-toggle-icon {
    width: 30px;
    height: 24px;
    padding: 10px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: var(--accent);
    opacity: 0.35;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.theme-toggle-icon:hover {
    opacity: 0.6;
}

.theme-toggle-icon--active {
    opacity: 1;
}

.theme-toggle-icon--active:hover {
    opacity: 1;
}

#theme-icon-light {
    border-right-width: 1px;
    border-right-color: var(--border-strong);
}

.social-button {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 10px;
    margin-left: 8px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: transparent;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.social-button:hover {
    background-color: var(--bg-card);
}

.social-button-icon {
    width: 13px;
    height: 13px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.social-button-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--text-secondary);
}

.header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 16px;
    background-color: var(--bg-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.header-text {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
}

.title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-title);
    white-space: normal;
}

.subtitle {
    font-size: 10px;
    color: var(--text-secondary);
    margin-top: 3px;
}

.ring {
    width: 52px;
    height: 52px;
    margin-right: 12px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.ring-accent-color {
    background-color: var(--accent);
}

.ring-track-color {
    background-color: var(--border);
}

.ring-complete-color {
    background-color: var(--status-ok);
}

.ring-icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.ring-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.refresh-button {
    flex-direction: row;
    align-items: center;
    padding: 5px 12px;
    margin-left: 10px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--border-strong);
    flex-shrink: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.refresh-button:hover {
    background-color: var(--bg-card);
}

.refresh-button:active .refresh-icon {
    rotate: 180deg;
}

.refresh-icon {
    width: 13px;
    height: 13px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.refresh-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--text-secondary);
}

.scroll {
    flex-grow: 1;
}

.list {
    padding: 12px 16px 4px 16px;
}

.section-header {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    margin-bottom: 6px;
}

.section-title {
    font-size: 12px;
    margin-left: 10px;
    padding-bottom: 10px;
    -unity-font-style: bold;
    color: var(--accent);
}

.section-header-spacer {
    flex-grow: 1;
}

.section-progress {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--status-error);
}

.section-complete {
    font-size: 12px;
    margin-right: 10px;
    padding-bottom: 10px;
    -unity-font-style: bold;
    color: var(--status-ok);
}

.section-header--clickable {
    cursor: link;
}

.section-header--clickable:hover .section-title {
    color: var(--text-primary);
}

.section-chevron {
    font-size: 10px;
    width: 12px;
    padding-bottom: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--accent);
}

.card {
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-card);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.card:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--border-strong);
}

.card--reminder {
    background-color: var(--bg-card-reminder);
    border-color: var(--border);
    align-items: flex-start;
}

.card-icon {
    width: 15px;
    height: 15px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.card--reminder .card-icon {
    margin-top: 2px;
}

.card-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.card-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-primary);
    white-space: normal;
}

.card-description {
    font-size: 11px;
    color: var(--text-secondary);
    white-space: normal;
    margin-top: 3px;
}

.card-action-hint {
    font-size: 10px;
    color: var(--text-muted);
    white-space: normal;
    margin-top: 4px;
    -unity-font-style: italic;
    display: none;
}

.status-fix .card-action-hint {
    display: flex;
}

.card-result {
    font-size: 10px;
    color: var(--status-ok);
    white-space: normal;
    margin-top: 4px;
    -unity-font-style: bold;
    display: none;
}

.card-tag {
    font-size: 10px;
    margin-left: 10px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    display: none;
}

.status-ok .card-tag {
    display: flex;
    color: var(--status-ok);
}

.status-manual .card-tag {
    display: flex;
    color: var(--text-secondary);
}

.card-action {
    background-color: var(--accent);
    color: var(--accent-text);
    border-width: 0;
    border-radius: 5px;
    padding: 5px 12px;
    margin: 0 0 0 10px;
    font-size: 10px;
    -unity-font-style: bold;
    flex-shrink: 0;
    display: none;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.card-action:hover {
    background-color: #1e40e0;
}

.card-action:active {
    background-color: #2f6fd6;
}

.status-fix .card-action {
    display: flex;
}

.footer {
    flex-direction: column;
    flex-shrink: 0;
    padding: 8px 16px 10px 16px;
    background-color: var(--bg-header);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.footer-disclaimer {
    font-size: 9px;
    -unity-font-style: italic;
    color: var(--text-muted);
    white-space: normal;
    margin-bottom: 6px;
}

.footer-buttons-row {
    flex-direction: row;
    align-items: center;
}

.footer-spacer {
    flex-grow: 1;
}

.footer-link {
    background-color: transparent;
    border-width: 0;
    -unity-font-style: bold;
    color: var(--status-error);
    font-size: 12px;
    padding: 4px 2px;
    -unity-text-align: middle-left;
    transition-property: color;
    transition-duration: 0.1s;
}

.footer-link:hover {
    color: var(--text-primary);
}

.footer-button {
    background-color: var(--border);
    color: var(--text-primary);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 11px;

    transition-property: background-color;
    transition-duration: 0.1s;
}

.footer-button:hover {
    background-color: var(--border-strong);
}